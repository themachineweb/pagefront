{
  "name": "@pagefront/lint-core",
  "version": "0.4.0",
  "description": "Vertical-agnostic Pagefront linter engine: rule runner, report emitter, renderers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themachineweb/pagefront.git",
    "directory": "core/lint"
  },
  "homepage": "https://github.com/themachineweb/pagefront/tree/main/core/lint#readme",
