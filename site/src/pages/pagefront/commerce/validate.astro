---
/**
 * Check: the hosted checker for Pagefront commerce sheets, at
 * /pagefront/commerce/validate.
 * One field takes a page URL, a sheet URL or a pasted sheet. A page URL
 * is checked on the server (worker/validate.ts, page-check.ts), because
 * a page's Link header is not readable cross-origin: discovery, the hop
 * to the sheet, the envelope's coherence with the page, and then the
 * conformance report. A sheet URL goes through the same endpoint and
 * gets the conformance report alone; a pasted sheet is judged here in
 * the browser. The sheet type is read from the document, the $schema
 * URL first and the data block second, and is never asked for.
 *
 * Standing rules for this page (inherit them, don't relitigate):
 *
 * 1. THE ENDPOINT IS A CHECKER, NOT A FETCHER. It returns the report
 *    only, never fetched bytes, fetches https only, follows a page's
 *    own declaration and nothing else, and is bounded and rate-limited
 *    as worker/validate.ts lists.
 * 2. CONFORMANCE ONLY. No score, anywhere on this page. Scoring is
 *    consumer-side per commerce/spec/scoring.md; this page renders the
 *    linter's judgment and the spec's discovery rules, nothing more.
 * 3. NO EXTRACTION AFFORDANCE, EVER. When a URL yields no sheet, the
 *    result is a dead-end pointing at the spec for how publishers add
 *    one. NEVER "want us to generate one?": that act is an operator's
 *    product and does not exist under this domain.
 */
import Base from '../../../layouts/Base.astro';
import { LINKS, pagefrontNav } from '../../../lib/links';
import { SPEC_BASE, SPEC_DOCS } from '../../../lib/spec-routes.mjs';
import { CURRENT_RELEASE, currentSheetSpec, LEGACY_FORMATS } from '../../../lib/releases.mjs';

const legacyFormat = LEGACY_FORMATS[LEGACY_FORMATS.length - 1];
---

<Base
  title="Check — Pagefront"
  description={`Check a product page's sheet declaration and the sheet it points at, or a sheet on its own, against the Pagefront commerce specs at release ${CURRENT_RELEASE}.`}
  canonical="https://themachineweb.org/pagefront/commerce/validate"
  section="Pagefront"
  sectionHref={LINKS.landing}
  navLabel="Pagefront"
  nav={pagefrontNav('validator')}
>
  <h1>Check</h1>
  <p class="lede">
    Paste a page URL to check discovery and the sheet it declares, a bare
    origin to check its entry point, or a sheet URL or the sheet itself to
    check conformance alone.
  </p>

  <div class="checker" id="checker">
    <form id="form" class="panel">
      <textarea id="input" rows="6" placeholder={`https://merchant.example/product/anorak\n\nor the sheet: {"release": "${CURRENT_RELEASE}", …}`}
                spellcheck="false" required></textarea>
      <button type="submit">Check</button>
    </form>

    <div id="result" aria-live="polite"></div>

    <p class="tool-meta">
      Commerce release {CURRENT_RELEASE} (Product Sheet spec {currentSheetSpec('product')}, Organization Sheet spec {currentSheetSpec('organization')}) and legacy sheets carrying <code>format_version</code> {legacyFormat}.
      Programs can ask for the same result as JSON from <code>/pagefront/commerce/validate.json</code> with <code>?url=…</code>, <code>?sheet=…</code> or a POST body.
      Rule catalogue: <a href={`${SPEC_BASE}/${SPEC_DOCS['commerce/spec/rules'].route}`}>rules.md</a>.
      Linter design: <a href={`${SPEC_BASE}/${SPEC_DOCS['core/spec/linter'].route}`}>linter.md</a>.
    </p>
  </div>
</Base>

<style>
  .lede { font-family: var(--sans); font-size: .95rem; color: var(--ink-soft); margin: -1rem 0 1.5rem; }
  .checker { font-family: var(--sans); font-size: .95rem; }
  .panel { display: flex; flex-direction: column; gap: .75rem; }
  .panel textarea { font: inherit; padding: .6rem .75rem; border: 1px solid var(--rule);
          border-radius: 6px; background: #fffdf8; color: var(--ink); width: 100%;
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; }
  .panel button { font: inherit; font-weight: 600; align-self: flex-start; padding: .5rem 1.25rem;
          border: 1px solid var(--ink); border-radius: 6px; background: var(--ink);
          color: var(--paper); cursor: pointer; }
  #result { margin-top: 1.75rem; }
  #result h2 { font-family: var(--sans); font-size: 1rem; font-weight: 700; letter-spacing: -0.01em;
          margin: 1.75rem 0 .5rem; }
  #result h2:first-child { margin-top: 0; }
  #result .judged { color: var(--ink-soft); font-size: .85rem; text-transform: uppercase;
          letter-spacing: .04em; margin: 0 0 .5rem; }
  #result .status { font-weight: 600; margin: 0 0 .75rem; }
  #result .clean { color: #15803d; }
  #result .problem { color: #b91c1c; }
  #result .note { color: var(--ink-soft); margin: .5rem 0; }
  #result ol, #result ul { list-style: none; margin: 1rem 0; padding: 0; }
  #result ul.lines { margin: .5rem 0; }
  #result ul.lines li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0 .5rem; padding: .3rem 0;
          border-bottom: 1px solid var(--rule); }
  #result ul.lines .mark { font-weight: 700; }
  #result ul.lines .detail { grid-column: 2; color: var(--ink-soft); font-size: .88rem; overflow-wrap: anywhere; }
  #result ul.lines .remediation { grid-column: 2; font-size: .88rem; overflow-wrap: anywhere; }
  #result ul.lines li.pass .mark { color: #15803d; }
  #result ul.lines li.warning .mark { color: #b45309; }
  #result ul.lines li.fail .mark { color: #b91c1c; }
  #result ul.lines li.info .mark { color: #0369a1; }
  #result ol li { border: 1px solid var(--rule); border-left: 4px solid var(--ink-soft);
          border-radius: 6px; padding: .6rem .9rem; margin: 0 0 .75rem; }
  #result ol li.sev-error { border-left-color: #b91c1c; }
  #result ol li.sev-warning { border-left-color: #b45309; }
  #result ol li.sev-info { border-left-color: #0369a1; }
  #result .sev { font-weight: 700; margin-right: .5rem; }
  #result li.sev-error .sev { color: #b91c1c; }
  #result li.sev-warning .sev { color: #b45309; }
  #result li.sev-info .sev { color: #0369a1; }
  #result .rule-id { font-weight: 600; margin-right: .5rem; }
  #result code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em;
          background: #efe9db; padding: .1em .3em; border-radius: 4px; overflow-wrap: anywhere; }
  #result .msg { margin: .4rem 0 0; }
  #result .fix { margin: .35rem 0 0; color: var(--ink-soft); }
  #result details { margin: 1.25rem 0; }
  #result summary { cursor: pointer; color: var(--ink-soft); }
  #result pre { overflow-x: auto; background: #efe9db; padding: .75rem; border-radius: 6px;
          font-size: .8rem; line-height: 1.45; }
  #result .copy { font: inherit; font-size: .85rem; padding: .25rem .75rem; margin-left: .75rem;
          border: 1px solid var(--rule); border-radius: 6px; background: none; cursor: pointer; }
  #result .versions { color: var(--ink-soft); font-size: .85rem; margin-top: 1rem; }
  .tool-meta { color: var(--ink-soft); font-size: .85rem; border-top: 1px solid var(--rule);
          margin-top: 2.5rem; padding-top: 1rem; }
</style>

<script>
  import { buildResult, SHEET_LABEL } from '../../../lib/validate-model';
  import { CURRENT_RELEASE, LEGACY_FORMATS } from '../../../lib/releases.mjs';
  import type { RenderModel } from '../../../lib/validate-model';

  const ENDPOINT = '/pagefront/commerce/validate.json';
  const SPECS = [
    { label: 'product.md', url: '/pagefront/spec/commerce/product' },
    { label: 'organization.md', url: '/pagefront/spec/commerce/organization' },
  ];

  type Line = { check: string; status: 'pass' | 'warning' | 'fail' | 'info'; detail?: string; remediation?: string };
  type PageCheck = {
    kind: 'page-check'; page_url: string; final_url: string; redirects: number; entry_point?: Line[];
    discovery: Line[]; hop: Line[]; coherence: Line[]; conformance: RenderModel | null; sheet_url?: string;
  };
  type Outcome = (RenderModel | PageCheck | { kind: 'bad-request'; detail: string } | { kind: 'rate-limited' }) & { entry_point?: Line[] };

  const form = document.getElementById('form') as HTMLFormElement;
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const result = document.getElementById('result') as HTMLDivElement;

  function el(tag: string, className: string | null, text?: string): HTMLElement {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  const MARK = { pass: '✓', warning: '!', fail: '✗', info: 'i' } as const;

  function renderLines(title: string, lines: Line[], into: HTMLElement): void {
    into.append(el('h2', null, title));
    const list = el('ul', 'lines');
    for (const line of lines) {
      const item = el('li', line.status);
      item.append(el('span', 'mark', MARK[line.status]));
      item.append(el('span', 'check', line.check));
      if (line.detail) item.append(el('span', 'detail', line.detail));
      if (line.remediation) item.append(el('span', 'remediation', line.remediation));
      list.append(item);
    }
    into.append(list);
  }

  function renderSheet(model: RenderModel, into: HTMLElement): void {
    if (model.kind === 'invalid-json') {
      into.append(el('p', 'status problem', 'Not valid JSON.'));
      into.append(el('p', 'note', model.message));
      return;
    }

    if (model.kind === 'no-sheet') {
      into.append(el('p', 'status problem', 'No Pagefront sheet at this URL.'));
      const note = el('p', 'note', `(${model.detail}.) See the specs for how publishers add one: `);
      SPECS.forEach((spec, i) => {
        const link = el('a', null, spec.label) as HTMLAnchorElement;
        link.href = spec.url;
        note.append(link);
        if (i < SPECS.length - 1) note.append(', ');
      });
      into.append(note);
      return;
    }

    if (model.kind === 'fetch-error') {
      into.append(el('p', 'status problem', 'The URL could not be fetched.'));
      into.append(el('p', 'note', model.detail));
      return;
    }

    if (model.kind === 'scope-error') {
      into.append(el('p', 'status problem', 'Out of scope.'));
      into.append(el('p', 'note',
        `Check covers commerce release ${CURRENT_RELEASE} and legacy sheets at format ${LEGACY_FORMATS[LEGACY_FORMATS.length - 1]}; ` +
        `this sheet declares ${model.declared}.`));
      return;
    }

    if (model.kind === 'unknown-type') {
      into.append(el('p', 'status problem', 'This document does not say which sheet type it is.'));
      into.append(el('p', 'note',
        'A sheet names its type in $schema, or in the data block: @type Product or ProductGroup for a product sheet, ' +
        '@type Organization with pagefront:commerceRole for an organization sheet, @type Collection with pagefront:collectionKind for a collection sheet. Nothing was judged.'));
      return;
    }

    if (model.kind === 'unsupported-type') {
      into.append(el('p', 'judged', `Judged as: ${SHEET_LABEL[model.sheet_type]}`));
      into.append(el('p', 'status problem', `${SHEET_LABEL[model.sheet_type]}s cannot be checked yet.`));
      into.append(el('p', 'note',
        'The Collection Sheet spec is a draft; its schema and rules join the published linter with the next release. Nothing was judged.'));
      return;
    }

    const label = SHEET_LABEL[model.sheet_type];
    const catalogue = model.sheet_type;
    into.append(el('p', 'judged', `Judged as: ${label}`));

    if (model.kind === 'layer1') {
      const n = model.schemaErrors.length;
      into.append(el('p', 'status problem',
        `Layer 1 — structural validation failed (${n} error${n === 1 ? '' : 's'}).`));
      into.append(el('p', 'note',
        `The sheet does not conform to the ${catalogue} JSON Schema. The rule catalogue runs only against schema-valid sheets.`));
      const list = el('ol', null);
      for (const e of model.schemaErrors) {
        const item = el('li', 'sev-error');
        item.append(el('code', null, e.instancePath === '' ? '(root)' : e.instancePath));
        item.append(el('p', 'msg', e.message));
        list.append(item);
      }
      into.append(list);
      return;
    }

    const report = model.report;
    const { errors, warnings, info, rules_fired } = report.summary;
    if (report.findings.length === 0) {
      into.append(el('p', 'status clean', `✓ No findings — well-formed under the commerce ${catalogue} catalogue.`));
    } else {
      into.append(el('p', 'status',
        `${errors} error${errors === 1 ? '' : 's'} · ${warnings} warning${warnings === 1 ? '' : 's'} · ${info} info` +
        ` — rules fired: ${rules_fired.join(', ')}`));
      const list = el('ol', null);
      for (const f of report.findings) {
        const item = el('li', `sev-${f.severity}`);
        const head = el('p', null);
        head.append(el('span', 'sev', f.severity));
        head.append(el('span', 'rule-id', f.rule));
        head.append(el('code', null, f.path));
        item.append(head);
        item.append(el('p', 'msg', f.message));
        item.append(el('p', 'fix', `fix: ${f.remediation}`));
        list.append(item);
      }
      into.append(list);
    }

    const json = JSON.stringify(report, null, 2);
    const details = el('details', null);
    const summary = el('summary', null, 'Canonical JSON report');
    const copy = el('button', 'copy', 'Copy') as HTMLButtonElement;
    copy.type = 'button';
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(json);
      copy.textContent = 'Copied';
      setTimeout(() => { copy.textContent = 'Copy'; }, 1500);
    });
    summary.append(copy);
    details.append(summary);
    details.append(el('pre', null, json));
    into.append(details);

    into.append(el('p', 'versions',
      `linter ${report.linter_version} · catalogue ${report.catalogue_version} · ` +
      `release ${report.release ?? 'none'} · sheet spec ${report.sheet_spec_version ?? 'none'} · checked ${report.checked_at}`));
  }

  function render(outcome: Outcome): void {
    result.replaceChildren();
    if (outcome.kind === 'bad-request') {
      result.append(el('p', 'status problem', 'That input could not be checked.'));
      result.append(el('p', 'note', outcome.detail));
      return;
    }
    if (outcome.kind === 'rate-limited') {
      result.append(el('p', 'status problem', 'Too many checks right now.'));
      result.append(el('p', 'note', 'The endpoint is rate-limited per publisher and in total. Try again in a minute.'));
      return;
    }
    if (outcome.kind === 'page-check') {
      const intro = outcome.redirects > 0
        ? `Page: ${outcome.final_url} (after ${outcome.redirects} redirect${outcome.redirects === 1 ? '' : 's'})`
        : `Page: ${outcome.final_url}`;
      result.append(el('p', 'note', intro));
      if (outcome.entry_point) renderLines('Entry point', outcome.entry_point, result);
      renderLines('Discovery', outcome.discovery, result);
      renderLines('The hop', outcome.hop, result);
      renderLines('Coherence', outcome.coherence, result);
      result.append(el('h2', null, 'Conformance'));
      if (outcome.conformance) {
        renderSheet(outcome.conformance, result);
      } else {
        result.append(el('p', 'note', 'No sheet was reached, so nothing was judged.'));
      }
      return;
    }
    if (outcome.entry_point) {
      renderLines('Entry point', outcome.entry_point, result);
      result.append(el('h2', null, 'Conformance'));
    }
    renderSheet(outcome, result);
  }

  async function checkUrl(url: string): Promise<void> {
    result.replaceChildren(el('p', 'note', 'Fetching…'));
    let response: Response;
    try {
      response = await fetch(`${ENDPOINT}?url=${encodeURIComponent(url)}`, { headers: { accept: 'application/json' } });
    } catch (error) {
      render({ kind: 'fetch-error', detail: (error as Error).message });
      return;
    }
    render(await response.json() as Outcome);
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = input.value.trim();
    if (value.startsWith('{') || value.startsWith('[')) {
      render(buildResult(value, 'paste'));
      return;
    }
    let url: URL | null = null;
    try { url = new URL(value); } catch { url = null; }
    if (!url || (url.protocol !== 'https:' && url.protocol !== 'http:')) {
      render({ kind: 'bad-request', detail: 'Paste a page URL, a sheet URL, or the sheet JSON itself.' });
      return;
    }
    void checkUrl(url.href);
  });

  // A `?url=` parameter pre-fills the field and runs the check, so a page
  // can link straight into one (the case studies do). The value goes
  // through the same path as a typed URL; nothing else.
  const prefill = new URLSearchParams(location.search).get('url');
  if (prefill) {
    input.value = prefill;
    form.requestSubmit();
  }
</script>
