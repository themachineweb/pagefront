---
/**
 * /pagefront/publish/write/<platform> — the prompt a merchant hands to a
 * chat assistant to write the sheets for a shop, from a list of its
 * product pages' addresses. The prompt text is commerce/prompts/write-<platform>-chat.md,
 * read through the prompts collection, and is also served verbatim at
 * the same path plus ".md"; this page wraps it with a short brief and a
 * copy button, as /pagefront/publish/assistant does for the one-product
 * prompt.
 */
import Section from '../../../../layouts/Section.astro';
import { LINKS } from '../../../../lib/links';
import { WRITE_PLATFORMS, promptBody, promptSetLine, type WritePlatform } from '../../../../lib/prompts';

export function getStaticPaths() {
  return Object.keys(WRITE_PLATFORMS).map((platform) => ({ params: { platform } }));
}

const platform = Astro.params.platform as WritePlatform;
const meta = WRITE_PLATFORMS[platform];
const prompt = await promptBody(`write-${platform}-chat`);
const setLine = promptSetLine(prompt);
const PATH = `${LINKS.publish}/write/${platform}`;
const RAW_URL = `${PATH}.md`;
const title = `Write your sheets — ${meta.titleSuffix}`;
---

<Section
  title={`${title} — Pagefront`}
  description={`A prompt to hand a chat assistant to write every Pagefront sheet for a ${meta.label} shop: give it the addresses of the product pages and it writes the product, collection and organization sheets and a report, inventing no value.`}
  path={PATH}
>
  <header class="doc-head">
    <p class="pf-kicker"><a href={LINKS.landing}>Pagefront</a> · <a href={LINKS.publish}>Publish</a></p>
    <h1>{title}</h1>
  </header>

  <div class="doc-body">
    <p>
      Copy the prompt below into ChatGPT, Claude or another chat assistant
      and send it as is. Its first reply asks for the addresses of the
      product pages you want sheets for; answer with the list. Paste the
      list with the prompt and it starts at once. It works out your shop
      from those addresses, reads the spec and the shop, writes the product
      sheets, the collection sheets that list those products and the
      organization sheet, and hands them back as files with a report in
      plain words of what it read and anything it had to leave out. The
      assistant needs to be able to fetch web pages; one that cannot will
      say so.
    </p>
    <p>
      What comes back is a draft. The prompt forbids the assistant from
      inventing any value, but it can still misread a page. Check the prices,
      the availability and the identifiers yourself before you serve the
      sheets, then run them through <a href={LINKS.validator}>Check</a>. The
      rest of the procedure is on the <a href={LINKS.publish}>publishing page</a>.
    </p>
    <p class="pf-note">
      Markdown version: <a href={RAW_URL}>{RAW_URL}</a>
    </p>
  </div>

  <div class="prompt-box">
    <div class="prompt-bar">
      <span class="prompt-title">Prompt · {meta.titleSuffix} · {setLine}</span>
      <button type="button" class="prompt-copy" id="prompt-copy">Copy prompt</button>
    </div>
    <pre id="prompt-text">{prompt}</pre>
  </div>
</Section>

<style is:global>
  .prompt-box{
    margin-top: clamp(1.5rem,4vw,2.25rem);
    border:1px solid var(--rule);
    border-radius:6px;
    overflow:hidden;
  }
  .prompt-bar{
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
    padding:.6rem .9rem;
    border-bottom:1px solid var(--rule);
    font-family:var(--sans); font-size:.85rem; color:var(--ink-soft);
  }
  .prompt-title{ font-weight:600; }
  .prompt-copy{
    font:inherit; font-weight:600; font-size:.8rem;
    padding:.25rem .75rem; border:1px solid var(--rule); border-radius:999px;
    background:transparent; color:var(--ink-soft); cursor:pointer;
  }
  .prompt-copy:hover{ color:var(--ink); border-color:var(--ink); }
  .prompt-box pre{
    margin:0; padding:1rem 1.1rem;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.78rem; line-height:1.55;
    white-space:pre-wrap; overflow-wrap:anywhere;
    background:#efe9db;
  }
</style>

<script>
  const button = document.getElementById('prompt-copy') as HTMLButtonElement;
  const text = document.getElementById('prompt-text') as HTMLPreElement;
  button.addEventListener('click', async () => {
    await navigator.clipboard.writeText(text.textContent ?? '');
    button.textContent = 'Copied';
    setTimeout(() => { button.textContent = 'Copy prompt'; }, 1500);
  });
</script>
