---
/**
 * /pagefront/publish/check/<platform> — the prompt a merchant hands to a
 * chat assistant to check, as an agent would, that the shop's sheets are
 * found from its homepage, per Pagefront Discovery. The prompt text is
 * commerce/prompts/check-<platform>-chat.md, read through the prompts
 * collection, and is also served verbatim at the same path plus ".md";
 * this page wraps it with a short brief and a copy button, as the write,
 * serve and link pages do.
 */
import Section from '../../../../layouts/Section.astro';
import { LINKS } from '../../../../lib/links';
import { CHECK_PLATFORMS, promptBody, promptSetLine, type CheckPlatform } from '../../../../lib/prompts';

export function getStaticPaths() {
  return Object.keys(CHECK_PLATFORMS).map((platform) => ({ params: { platform } }));
}

const platform = Astro.params.platform as CheckPlatform;
const meta = CHECK_PLATFORMS[platform];
const prompt = await promptBody(`check-${platform}-chat`);
const setLine = promptSetLine(prompt);
const PATH = `${LINKS.publish}/check/${platform}`;
const RAW_URL = `${PATH}.md`;
const LINK_URL = `${LINKS.publish}/link/${platform}`;
const title = `Check your sheets — ${meta.titleSuffix}`;
---

<Section
  title={`${title} — Pagefront`}
  description={`A prompt to hand a chat assistant to check that a ${meta.label} shop's Pagefront sheets are found the way an agent finds them: give it the shop's homepage address and it walks the entry point, the sheets and the links between them, runs the Check on each page, and hands you a report naming what to fix and in which phase.`}
  path={PATH}
>
  <header class="doc-head">
    <p class="pf-kicker"><a href={LINKS.landing}>Pagefront</a> · <a href={LINKS.publish}>Publish</a></p>
    <h1>{title}</h1>
  </header>

  <div class="doc-body">
    <p>
      Copy the prompt below into ChatGPT, Claude or another chat assistant
      and send it. It asks for one thing, your shop's homepage address, and
      needs no file. It then does what an agent reading your shop would do:
      from your homepage it follows the entry point to your shop's main
      sheet, walks down to each collection and product sheet and back up,
      runs the <a href={LINKS.validator}>Check</a> on each page, and tries
      to go from the main sheet to every product and back by the sheets
      alone. It checks how the sheets are found, and it changes nothing;
      what the sheets say is the write prompt's question. It hands you a
      report in plain words: what an
      agent cannot reach, what it reaches the long way, and for each the
      phase that fixes it, the <a href={`${LINKS.publish}/write/${platform}`}>write</a>,
      the <a href={`${LINKS.publish}/serve/${platform}`}>serve</a> or the
      <a href={LINK_URL}>link</a> prompt. The assistant needs to be able to
      fetch web pages; one that cannot will say so.
    </p>
    <p>
      Run it after the link prompt, after any later run of a prompt, and
      after a change to your theme or your platform.
    </p>
    <p class="pf-note">
      Markdown version: <a href={RAW_URL}>{RAW_URL}</a>
    </p>
  </div>

  <div class="prompt-box">
    <div class="prompt-bar">
      <span class="prompt-title">Prompt · {meta.titleSuffix} · {setLine}</span>
      <button type="button" class="prompt-copy" id="prompt-copy">Copy prompt</button>
    </div>
    <pre id="prompt-text">{prompt}</pre>
  </div>
</Section>

<style is:global>
  .prompt-box{
    margin-top: clamp(1.5rem,4vw,2.25rem);
    border:1px solid var(--rule);
    border-radius:6px;
    overflow:hidden;
  }
  .prompt-bar{
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
    padding:.6rem .9rem;
    border-bottom:1px solid var(--rule);
    font-family:var(--sans); font-size:.85rem; color:var(--ink-soft);
  }
  .prompt-title{ font-weight:600; }
  .prompt-copy{
    font:inherit; font-weight:600; font-size:.8rem;
    padding:.25rem .75rem; border:1px solid var(--rule); border-radius:999px;
    background:transparent; color:var(--ink-soft); cursor:pointer;
  }
  .prompt-copy:hover{ color:var(--ink); border-color:var(--ink); }
  .prompt-box pre{
    margin:0; padding:1rem 1.1rem;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.78rem; line-height:1.55;
    white-space:pre-wrap; overflow-wrap:anywhere;
    background:#efe9db;
  }
</style>

<script>
  const button = document.getElementById('prompt-copy') as HTMLButtonElement;
  const text = document.getElementById('prompt-text') as HTMLPreElement;
  button.addEventListener('click', async () => {
    await navigator.clipboard.writeText(text.textContent ?? '');
    button.textContent = 'Copied';
    setTimeout(() => { button.textContent = 'Copy prompt'; }, 1500);
  });
</script>
