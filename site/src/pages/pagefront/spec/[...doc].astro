---
/**
 * Every published specification document, rendered from the repository
 * markdown. Routes come from SPEC_DOCS; a document not listed there is not
 * published, however complete it may be in the repo. A document with
 * design notes renders them on the same page, as footnotes under the spec.
 */
import { getCollection, getEntry, render } from 'astro:content';
import SpecDoc from '../../../layouts/SpecDoc.astro';
import { SPEC_DOCS, SPEC_BASE } from '../../../lib/spec-routes.mjs';
import { schemaPath } from '../../../lib/releases.mjs';

/**
 * A document that has a JSON Schema gets a chip linking to it: the
 * schema of the sheet-spec version the current release bundles, per
 * commerce/spec/releases.json. The link is to a released, frozen schema,
 * never to the editable head.
 */
const schemaLink = (sheetType: string | undefined): string | undefined =>
  sheetType ? schemaPath(sheetType) : undefined;

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  return entries
    .filter((entry) => SPEC_DOCS[entry.id])
    .map((entry) => ({
      params: { doc: SPEC_DOCS[entry.id].route },
      props: { entry, meta: SPEC_DOCS[entry.id] },
    }));
}

const { entry, meta } = Astro.props;
const { Content, headings } = await render(entry);

let Notes: typeof Content | undefined;
if (meta.notes) {
  const notesEntry = await getEntry('spec', meta.notes.id);
  if (!notesEntry) throw new Error(`design notes not found in repository: ${meta.notes.source}`);
  Notes = (await render(notesEntry)).Content;
}
---

<SpecDoc
  title={meta.title}
  blurb={meta.blurb}
  status={meta.status}
  statusLine={meta.statusLine}
  schema={schemaLink(meta.schemaType)}
  route={meta.route}
  headings={headings}
  notesMarkdown={meta.notes ? `${SPEC_BASE}/${meta.notes.route}.md` : undefined}
>
  <Content />
  {Notes && <Fragment slot="notes"><Notes /></Fragment>}
</SpecDoc>
