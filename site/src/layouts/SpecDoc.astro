---
/**
 * One published specification document: kicker, title, status pill, a
 * chip to the markdown twin and, for a document with a JSON Schema, a
 * chip linking to it, then the
 * status line, an "On this page" box over the
 * top-level headings, then the rendered repository markdown. The
 * markdown's own H1 repeats the title and is hidden by the doc-body
 * styles in /styles.css.
 *
 * A document with design notes passes them in the `notes` slot: they
 * render under the spec as a numbered, non-normative section, the targets
 * of the footnote markers the spec body carries (renderDesignNotes in
 * astro.config.mjs).
 */
import Section from './Section.astro';
import { SPEC_BASE } from '../lib/spec-routes.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  /** One-sentence summary; the page's meta description. */
  blurb: string;
  status: string;
  /** Status notice shown under the pill (not the description). */
  statusLine: string;
  /** Served URL of the document's JSON Schema, when it has one. */
  schema?: string;
  route: string;
  headings: Heading[];
  /** Served URL of the design notes' markdown twin, when the document has notes. */
  notesMarkdown?: string;
}

const { title, blurb, status, statusLine, schema, route, headings, notesMarkdown } = Astro.props;
const area = route.startsWith('commerce/') ? 'Commerce' : 'Core';
const hasNotes = Astro.slots.has('notes');
const toc = headings.filter((h) => h.depth === 2);
if (hasNotes) toc.push({ depth: 2, slug: 'design-notes', text: 'Design notes' });
---

<Section
  title={`${title} — Pagefront Spec`}
  description={blurb}
  path={`${SPEC_BASE}/${route}`}
  current="spec"
>
  <header class="doc-head">
    <p class="pf-kicker"><a href={SPEC_BASE}>Spec · {area}</a></p>
    <h1>{title}</h1>
    <p class="doc-meta">
      <span class:list={['pf-pill', `pf-pill-${status}`]}>{status}</span>
      <a class="doc-schema" href={`${SPEC_BASE}/${route}.md`}>Markdown <span aria-hidden="true">→</span></a>
      {schema && <a class="doc-schema" href={schema}>JSON Schema <span aria-hidden="true">→</span></a>}
    </p>
    <p class="doc-statusline">{statusLine}</p>
  </header>

  {toc.length > 0 && (
    <nav class="doc-toc" aria-label="On this page">
      <p class="doc-toc-title">On this page</p>
      <ul>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <div class="doc-body">
    <slot />
  </div>

  {hasNotes && (
    <section class="doc-notes" id="design-notes" aria-labelledby="design-notes-title">
      <header class="doc-notes-head">
        <h2 id="design-notes-title">Design notes</h2>
        <p class="doc-notes-lede">
          <span class="pf-pill pf-pill-non-normative">non-normative</span>
          <span>The reasoning behind the fields above. The spec governs; a note adds no requirement.</span>
          {notesMarkdown && <a class="doc-schema" href={notesMarkdown}>Markdown <span aria-hidden="true">→</span></a>}
        </p>
      </header>
      <div class="doc-body doc-notes-body">
        <slot name="notes" />
      </div>
    </section>
  )}
</Section>
