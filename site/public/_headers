# Workers static-assets header rules (developers.cloudflare.com/workers/static-assets/headers/).
# The prompt is served as a markdown file; without a charset, browsers guess a
# legacy encoding and mangle the em dashes and the euro sign.
/pagefront/publish/assistant.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/publish/write/*.md
	Content-Type: text/markdown; charset=utf-8

# The spec documents' markdown twins, and the model-facing index.
/pagefront/spec/commerce/product.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/organization.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/collection.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/vocabulary.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/rules.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/scoring.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/core/discovery.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/core/linter.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/commerce/*-changelog.md
	Content-Type: text/markdown; charset=utf-8
/pagefront/spec/core/*-changelog.md
	Content-Type: text/markdown; charset=utf-8
/llms.txt
	Content-Type: text/plain; charset=utf-8

# The published JSON Schemas (commerce/schemas/, frozen and append-only)
# are machine-facing public documents: served as JSON Schema, with open
# CORS so browser-based validators fetch them directly.
/pagefront/spec/commerce/product/*
	Content-Type: application/schema+json; charset=utf-8
	Access-Control-Allow-Origin: *

/pagefront/spec/commerce/organization/*
	Content-Type: application/schema+json; charset=utf-8
	Access-Control-Allow-Origin: *

/pagefront/spec/commerce/collection/*
	Content-Type: application/schema+json; charset=utf-8
	Access-Control-Allow-Origin: *

# The Pagefront Property Registry (commerce/spec/registry/properties.json),
# the machine-readable registry of propertyID values the Product Sheet spec
# publishes at this address.
/pagefront/commerce/registry/properties.json
	Content-Type: application/json; charset=utf-8
	Access-Control-Allow-Origin: *

/pagefront/spec/commerce/releases.md
	Content-Type: text/markdown; charset=utf-8

# The case studies' sheets are Pagefront sheets served from this domain:
# the sheet media type (the discovery link's type), with open CORS as the
# spec's serving note asks of every publisher.
/pagefront/commerce/case-studies/*.json
	Content-Type: application/pagefront+json; charset=utf-8
	Access-Control-Allow-Origin: *
