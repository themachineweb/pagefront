{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themachineweb.org/pagefront/spec/commerce/collection/v0.1.0.json",
  "title": "Pagefront Commerce Collection Sheet 0.1.0",
  "description": "Sheet spec version 0.1.0, a member of commerce release 0.5.0, the release with which the Collection Sheet spec joined the release line; it has no legacy draft line. Formal schema for the Pagefront Commerce Collection Sheet, the sheet describing a listing page: a category page, a curated collection page, a brand page on a multi-brand store or a filtered listing with a URL of its own. The envelope is the one every Pagefront Sheet carries: $schema, release, schema_org_version, canonical_url, generated_at and data are required, sheet_url and expires_at are optional, and format_version is not accepted beside release. The data block roots on Schema.org Collection and declares the pagefront prefix in the array form of @context, since every collection sheet uses pagefront:collectionKind, the required kind discriminator (category, collection or brand). hasPart lists the set's direct members as thin entries (@type, @id and url required; pagefront:sheetUrl, name and, on a Collection entry, pagefront:collectionKind optional) and may be empty; isPartOf lists the parent sets in the same entry shape; brand is the Brand reference a brand collection is keyed on. Validates the envelope and pagefront-namespaced extensions strictly; Schema.org-typed blocks permit additional unspecified properties.",
  "type": "object",
  "required": [
    "$schema",
    "release",
    "schema_org_version",
    "canonical_url",
    "generated_at",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "release": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "schema_org_version": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "sheet_url": {
      "type": "string",
      "format": "uri"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "$ref": "#/$defs/dataBlock"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dataBlock": {
      "type": "object",
      "required": [
        "@context",
        "@type",
        "@id",
        "name",
        "inLanguage",
        "url",
        "pagefront:collectionKind",
        "hasPart"
      ],
      "properties": {
        "@context": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          },
          "contains": {
            "type": "object",
            "required": [
              "pagefront"
            ],
            "properties": {
              "pagefront": {
                "const": "https://themachineweb.org/pagefront/vocabulary/"
              }
            }
          }
        },
        "@type": {
          "const": "Collection"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inLanguage": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "object"
            }
          ]
        },
        "brand": {
          "type": "object",
          "required": [
            "@type",
            "@id"
          ],
          "properties": {
            "@type": {
              "type": "string"
            },
            "@id": {
              "type": "string",
              "format": "uri"
            },
            "pagefront:sheetUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": true
        },
        "pagefront:collectionKind": {
          "$ref": "#/$defs/collectionKind"
        },
        "hasPart": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberEntry"
          }
        },
        "isPartOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberEntry"
          }
        },
        "pagefront:availableLanguages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lang",
              "url"
            ],
            "properties": {
              "lang": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "collectionKind": {
      "type": "string",
      "enum": [
        "category",
        "collection",
        "brand"
      ]
    },
    "memberEntry": {
      "type": "object",
      "required": [
        "@type",
        "@id",
        "url"
      ],
      "properties": {
        "@type": {
          "type": "string"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pagefront:sheetUrl": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string"
        },
        "pagefront:collectionKind": {
          "$ref": "#/$defs/collectionKind"
        }
      },
      "additionalProperties": true
    }
  }
}
